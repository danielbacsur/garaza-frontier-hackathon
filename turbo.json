{
  "$schema": "https://turborepo.dev/schema.json",

  "ui": "tui",

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },

    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
