{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Second Cursor",
  "version": "0.0.0",
  "identifier": "com.danielbacsur.computer-use-with-decisions",

  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "label": "panel",
        "url": "index.html?view=panel",
        "title": "Second Cursor",
        "width": 360,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      },

      {
        "label": "cursor",
        "url": "index.html?view=cursor",
        "title": "Second Cursor",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "focus": false
      }
    ],

    "security": {
      "csp": null
    },

    "macOSPrivateApi": true
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
